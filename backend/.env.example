# Django
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=

# Database (SQLite locally, PostgreSQL in docker/staging/production)
DATABASE_URL=sqlite:///db.sqlite3

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS_CUSTOMER=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS_STAFF=7

# Health API
HEALTH_CHECK_PASSWORD=change-me

# Celery (reserved: not used by the app yet)
CELERY_ENABLED=False
CELERY_BEAT_ENABLED=False
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False
CELERY_WORKER_CONCURRENCY=2

# API rate limiting
RATELIMIT_ANON=60/minute
RATELIMIT_USER=300/minute
RATELIMIT_AUTH=10/minute
RATELIMIT_QUOTE=60/minute
RATELIMIT_ORDERS=10/minute
RATELIMIT_SENSITIVE=30/minute
RATELIMIT_HEALTH=120/minute
RATELIMIT_CACHE_URL=redis://localhost:6379/2

# Staff user created by seed_abo_samra
ADMIN_PHONE=01000000000
ADMIN_PASSWORD=change-me
ADMIN_NAME=أبو سمرة

# Docker Compose (postgres)
POSTGRES_DB=abosamra
POSTGRES_USER=abosamra
POSTGRES_PASSWORD=change-me

# Deployment
DOMAIN=example.com
BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_PATH=/opt/abosamra/backend
FRONTEND_PATH=/opt/abosamra/frontend
MEDIA_PATH=/opt/abosamra/backend/media
STATIC_PATH=/opt/abosamra/backend/static
SYSTEMD_SERVICE_NAME=abosamra-backend

# Database backup (python manage.py backup_db)
BACKUP_DIR=/opt/abosamra/backups
BACKUP_RETENTION_DAYS=7
BACKUP_TIMEOUT_SECONDS=1800
BACKUP_PG_DUMP_PATH=pg_dump
BACKUP_NAME_PREFIX=db-backup
BACKUP_EMAIL_ENABLED=False
BACKUP_GOOGLE_DRIVE_ENABLED=False
BACKUP_EMAIL_RECIPIENTS=admin@example.com
BACKUP_EMAIL_SUBJECT_PREFIX=[Abo Samra]
BACKUP_EMAIL_MAX_ATTACHMENT_MB=20
BACKUP_CRON_HOUR=3
BACKUP_CRON_MINUTE=0
# Email (SMTP) - required only when BACKUP_EMAIL_ENABLED=True
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=60
DEFAULT_FROM_EMAIL=
# Google Drive - required only when BACKUP_GOOGLE_DRIVE_ENABLED=True
GOOGLE_DRIVE_AUTH_TYPE=service_account
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=/opt/abosamra/secrets/google-drive-sa.json
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_RETENTION_DAYS=30
